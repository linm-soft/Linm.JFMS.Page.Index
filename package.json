{
  "name": "linm-jfms-page-index",
  "private": true,
  "version": "1.0.0",
  "description": "J-FMS marketing / demo static site — Cloudflare",
  "scripts": {
    "dev": "npx --yes wrangler@4 dev --port 8788",
    "deploy": "npx --yes wrangler@4 deploy",
    "check": "node -e \"const fs=require('fs');const req=['index.html','_headers','_redirects','page-icon/title.png','page-icon/login.png','wrangler.toml'];for (const f of req){if(!fs.existsSync(f)){console.error('missing',f);process.exit(1)}}console.log('ok',req.length,'files')\""
  },
  "engines": {
    "node": ">=18"
  }
}
